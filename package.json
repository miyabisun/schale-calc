{
  "name": "schale-calc",
  "version": "1.0.0",
  "description": "ブルーアーカイブの計算結果を計算ごとのサブディレクトリにまとめ、GitHub Pagesで公開する",
  "main": "index.js",
  "scripts": {
    "fetch": "node equipment-blueprint/scripts/fetch.js",
    "build:normal": "node equipment-blueprint/scripts/build-normal-rewards.js",
    "verify:upgrade": "node equipment-blueprint/scripts/verify-upgrade-table.js",
    "plan:onia-golden": "node equipment-blueprint/scripts/plan-onia-golden.js && node equipment-blueprint/scripts/build-onia-golden-report.js",
    "build:gacha": "node gacha/scripts/calculate.js && node gacha/scripts/compare.js && node gacha/scripts/pickup.js",
    "build:dice-run": "node dice-run-occult-2026/scripts/build.js",
    "build": "npm run build:normal && npm run plan:onia-golden && npm run build:gacha && npm run build:dice-run",
    "test": "node --test equipment-blueprint/test/functions/*.test.js gacha/scripts/*.test.js dice-run-occult-2026/scripts/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miyabisun/schale-calc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/miyabisun/schale-calc/issues"
  },
  "homepage": "https://miyabisun.github.io/schale-calc/",
  "dependencies": {
    "javascript-lp-solver": "^1.0.3",
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
